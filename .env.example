# =========================================================================
# Stayful Intelligence — environment variables
# Copy to `.env.local` for local dev. Set the same vars on Vercel for prod.
# =========================================================================

# ── Supabase (auth + profiles DB) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (billing — REQUIRED in production) ────────────────────────────
# Checkout Sessions (plans and the first top-up), off-session PaymentIntents
# (one-click top-ups), the Billing Portal, the self-serve pause/cancel actions
# on /account and the webhook all call the Stripe API in earnest.
#
# STRIPE_SECRET_KEY    Read by src/lib/stripe/client.ts and the webhook. Without
#                      it /account and /account/billing degrade to "billing
#                      temporarily unavailable" and no subscription change or
#                      top-up can be made.
# STRIPE_WEBHOOK_SECRET Signature verification for /api/stripe/webhook. With no
#                      secret set at all the route answers 500 and every event
#                      is rejected, so paid subscriptions and top-ups never turn
#                      into credit.
#
# ONE SECRET PER ENDPOINT. Stripe signs each delivery with the secret of the
# endpoint it came from, so an account with two webhook endpoints needs both
# secrets or half the deliveries are refused with a 400. Set the second in
# STRIPE_WEBHOOK_SECRET2; every configured secret is tried until one verifies
# (see src/lib/billing/webhook-secrets.ts). Either variable may also hold
# several secrets separated by commas, so adding an endpoint or rotating a
# secret needs no code change and leaves no window of failed deliveries.
#
# The webhook endpoint must be on the API version the stripe package reads
# (2026-04-22.dahlia, or a later .dahlia; README §2): an endpoint on an older
# version passes the signature check, but every subscription invoice is skipped
# and no plan credit arrives, and its version cannot be changed afterwards.
# It must have these events enabled in the Stripe dashboard
# (Developers → Webhooks). Every event id is recorded in stripe_events first,
# so a redelivery can never double-grant credit:
#   checkout.session.completed        a plan or first top-up Checkout finished
#                                     (saves the card, records the subscription);
#                                     for the starter pack, claims it once per
#                                     person and captures or cancels the payment
#   invoice.paid                      turns a paid subscription invoice into a
#                                     plan-credit grant (create, renewal, upgrade)
#   invoice.payment_failed            marks the account past_due and emails
#   customer.subscription.created     links a subscription set up by hand in
#                                     the dashboard — it has no Checkout Session
#   customer.subscription.updated     carries pause, resume, plan change and
#                                     scheduled cancellation. Without it /account
#                                     still looks right (the server actions write
#                                     the columns directly) but the row silently
#                                     drifts from Stripe
#   customer.subscription.deleted     the subscription actually ended: plan
#                                     credit expires
#   payment_intent.succeeded          a one-click top-up was charged; the
#                                     starter pack's credit is granted
#   payment_intent.amount_capturable_updated / payment_intent.canceled
#                                     a starter pack's card was authorised (it
#                                     is claimed and captured, or cancelled as a
#                                     repeat), or its hold was cancelled (the
#                                     claim is let go) (Batch 20)
#   payment_method.attached           remembers the saved card
#   charge.refunded / charge.dispute.created   claws back a refunded or
#                                     disputed top-up or starter pack, and
#                                     takes it off "Total paid" (Batch 20)
#   charge.dispute.closed             gives the credit back when a dispute is
#                                     won or withdrawn (Batch 21); enable it on
#                                     the endpoint with the rest
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The second endpoint's signing secret, if there is one. Not a stray: see above.
STRIPE_WEBHOOK_SECRET2=

# ── Credit billing (usage-based) ─────────────────────────────────────────
# Every paid provider call is charged to the member's credit at cost × markup.
# CREDIT_ENFORCE=false runs in shadow mode: paid actions are metered and
# debited (into an overdraft at £0) but never refused (no 402s, no
# out-of-credit modal). The daily email, the picks-paused letter and the
# credit emails still act on the balance either way: a member at £0 gets no
# charged pick, the 08:20 letter instead of the daily email, and the
# out-of-credit email. Set true before the starter pack's date (README §16):
# a pack-era account starts at £0 and must not be able to overdraw.
CREDIT_ENFORCE=false
# Stripe prices — created by `node scripts/stripe-setup.mjs` (idempotent, prints
# these lines). STRIPE_PRICE_PRO is the existing £39.99/month price behind the
# old Payment Link so current subscribers land on the Pro tier untouched.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TOPUP_1000=
STRIPE_PRICE_TOPUP_2500=
STRIPE_PRICE_TOPUP_5000=
# Batch 20: the £10 starter pack, a one-off GBP price whose amount must equal
# billing_settings.starter_pack_price_pence (the pack refuses to sell otherwise).
STRIPE_PRICE_STARTER_PACK=
STRIPE_PORTAL_CONFIG_ID=
# Optional billing extras:
#   STRIPE_TAX=true              Collect VAT automatically at Checkout (enable Stripe Tax first).
#   STRIPE_TERMS_CONSENT=false   Skip the terms tick box on Checkout (it is requested by default and
#                                silently skipped when no Terms URL is set in the Stripe Dashboard).

# ── App ──────────────────────────────────────────────────────────────────
# The site's own address, with no trailing slash (src/lib/url.ts siteUrl()):
# every email link, the auth callback and reset links, the Twilio short link,
# the report link a funnel prospect is sent, and the sitemap are built from
# it. Set it locally (http://localhost:3000) and on every Vercel environment;
# unset, links point at the marketing site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# VERCEL_PROJECT_PRODUCTION_URL  Set by Vercel. A CRM delivery's report link
#                                falls back to it when NEXT_PUBLIC_SITE_URL is
#                                unset (src/lib/crm/deliver.ts). Nothing to set.
# A feedback report (Batch 18) records the app version it was sent from:
# Vercel's own VERCEL_GIT_COMMIT_SHA on the server and
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA in the browser. Nothing to set here, but
# "Automatically expose System Environment Variables" must be on in the
# Vercel project (Settings → Environment Variables); without it the report
# says "unknown".

# ── Email (Resend) ───────────────────────────────────────────────────────
# Every email goes through src/lib/email/send.ts: the daily email and
# alerts, billing and receipt emails, funnel reports, and (Batch 18) the
# email to the admin address for every feedback report and the status emails
# to the members who sent them. With either unset nothing is sent (each send
# is logged and skipped) and everything else keeps working. EMAIL_FROM is a
# sender on a domain verified in Resend, e.g. "Stayful <hello@stayful.co.uk>".
RESEND_API_KEY=
EMAIL_FROM=
# Batch 21: the sender for a white-label funnel's report email, so it does not
# arrive from a stayful.co.uk address. A neutral domain verified in Resend,
# e.g. "reports@<neutral-domain>"; the customer's company name is still the
# display name and their address the reply-to. Unset, EMAIL_FROM is used.
EMAIL_FROM_WHITELABEL=

# ── AI voice narrator (analyser summary — /api/summarise + /api/speak) ────
# Anthropic Claude generates the spoken summary of an analysis result, and
# (Batch 17) runs the Project deals photo check
# (src/lib/project/photo-check-server.ts): without the key the narrator
# answers 503 and the photo check is skipped, so no deal is held as a project.
ANTHROPIC_API_KEY=
# ElevenLabs reads the summary aloud. Without ELEVENLABS_API_KEY the narrator
# still shows the written summary; it just won't speak.
# ELEVENLABS_VOICE_ID (Batch 23): the ONE Stayful Intelligence voice — the
# analyser narrator and the phone agent both use it, read only through
# src/lib/persona/stayful-intelligence.ts (with the model and voice settings).
# Paste the voice Zac chose in ElevenLabs. Left blank, it falls back to the
# chosen British voice in that file (never ElevenLabs' stock "Rachel") and
# logs a warning at most once a day. Set it on Production and Preview.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Analyser data partners (required by /api/analyse) ────────────────────
AIRBTICS_API_KEY=
AIRBTICS_BASE_URL=
# PropertyData (propertydata.co.uk, API 5k plan: 5,000 credits a month, one
# credit per call). Every call goes through the data broker: floor area, the
# rent and sale valuations, stamp duty, council tax, EPC, flood risk, the
# planning designations, listed buildings and the outcode's market liquidity
# on each report (about 14 credits for a postcode nobody has run before;
# repeat postcodes are cache hits for weeks), plus the national mortgage
# averages daily and the region key stats (30 credits a region, at most four
# regions a day) bought as house spend by the 04:45 UTC market-warm cron.
# The broker's daily caps (BROKER_BUDGET_PROPERTYDATA, default 4000p ≈ 1,600
# credits; BROKER_MEMBER_BUDGET_PROPERTYDATA, default 1500p ≈ 40 reports per
# payer) are runaway guards, not the monthly limit: a report that hits them
# quietly degrades (national-median rent, no due diligence page), so keep
# them above the day's real demand. A funnel's leads bill the funnel owner.
# Once PropertyData replies that the monthly plan is spent (403, code X04),
# every call is paused until the next UTC day; the pause is shared through
# broker_cache so all instances stop at once.
# MARKET_WARM_ENABLED=false switches the 04:45 market-warm cron off (ON by
# default; ?dry=1 says what it would buy and roughly what that costs). Off,
# the key stats go stale after their month; members' reports never buy them.
# The snapshot's own long-let lookups for its areas are capped per UTC day by
# billing_settings.area_rent_daily_attempts (default 40, failed attempts
# included) and are house spend whoever's request rebuilds it.
PROPERTYDATA_API_KEY=

# ── Motivated-seller cohorts (PropertyData /sourced-properties) ────────────
# Opt-in: needs PROPERTYDATA_SOURCED_ENABLED=true as well as a key. A key alone
# is not consent to spend, because the analyser's own endpoints (/floor-areas,
# /valuation-rent, /valuation-sale) already draw on the same monthly allowance.
# One credit per cohort per area per run: 60 a run with the defaults below,
# roughly 1,800 a month at a daily cadence. On the 5,000-credit tier that is a
# third of the budget, so check there is room before turning it on.
#
# When the account is out of credits the endpoint answers HTTP 200 with an
# error body; the client treats that as account-level, stops asking for six
# hours rather than working through a hundred more identical failures, and does
# not record the call as a successful spend.
#
# This is the only source that can tell us a listing's real history on the day
# we first see it: their slow-to-sell list is properties continuously marketed
# for over a year, and price-reduced is 15%+ off the first asking price. Both
# are measured, so the scoring treats them as firm evidence in a way it never
# treats the wording of an advert.
PROPERTYDATA_SOURCED_ENABLED=
# Which cohorts to ask for, comma separated. Unknown names are ignored.
# Available: slow_to_sell, price_reduced, repossessed, quick_sale,
# back_on_market, chain_free, auction, tenanted, short_lease, unmodernised,
# cash_buyers_only. Default: the first five.
PROPERTYDATA_COHORTS=
# PropertyData's own docs give the `list` slugs inconsistently and rename them
# from time to time. Each cohort carries several candidates and the first the
# API accepts is remembered for the process, so a rename costs one wasted call
# rather than silence. When one changes for good, override it here without a
# deploy — e.g. PROPERTYDATA_LIST_SLOW_TO_SELL=slow-to-sell-properties.
# Confirm the current slugs and the response shape with:
#   PROPERTYDATA_API_KEY=... npm run probe:sourced -- "OX3 9DW"
PROPERTYDATA_LIST_SLOW_TO_SELL=
# Every full report geocodes the postcode first with this key (and the Places
# calls, the quiz's home postcode and the address lookup use it too). Missing,
# expired or over quota, every report fails before anything is charged, with
# "an unexpected error" (Batch 21: no longer "check your postcode").
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=

# Dev-only: lets scripts/calibrate.mjs bypass auth + trial gate on
# /api/analyse. Do NOT set on production. CALIBRATION_API_URL (scripts only)
# is the /api/analyse the script calls; default http://localhost:3000/api/analyse.
CALIBRATION_BYPASS_SECRET=

# ── Admin access ─────────────────────────────────────────────────────────
# Comma-separated allow-list of admin emails. Admin is granted by the logged-in
# user's verified email (never a password in code), giving unlimited/Pro access
# plus the /admin dashboard. Leave blank to use the built-in default
# (zac@stayful.co.uk). Set to add/replace admins without a code change.
ADMIN_EMAILS=

# ── Market Explorer (regions › areas › districts; intelligence.stayful.co.uk/markets) ─
# Built directly from the analyser_reports table with the service-role key
# (SUPABASE_SERVICE_ROLE_KEY above); no other service is called for the figures.
# INTERNAL_API_SECRET protects the /api/internal/* routes (crons, manual runs).
# MARKET_SAMPLE_AREA (optional): postcode area shown with real figures on the
# public /markets product page (default: the best-backed area).
# Phase 2 explorer extras (all optional):
#   MONDAY_PROPERTIES_BOARD_ID        Monday "Properties" board (default 4997066443) — powers
#                                     the "Stayful manages here" badge (Listed/Onboarding items).
#   MONDAY_MANAGEMENT_LEADS_BOARD_ID  Board that receives "talk to us about managing here"
#                                     enquiries (default 5891626711, the Management Leads board).
#   MONDAY_MANAGEMENT_LEADS_EMAIL_COL Email text column on that board (default text_mkygb5xx).
# The home-postcode geocode for distance ranking reuses GOOGLE_PLACES_API_KEY.
# Phase 3 trends + weekly alerts (all optional):
#   RESEND_API_KEY / EMAIL_FROM   Resend sender for the weekly saved-area digest,
#                                 the billing emails, and the report link a funnel
#                                 prospect is sent. A funnel email keeps this
#                                 ADDRESS but takes the customer's company name as
#                                 its display name and their reply-to, so it does
#                                 not arrive saying Stayful. Sending from the
#                                 customer's own domain needs per-customer DNS
#                                 verification and is not built yet
#                                 (e.g. "Stayful <hello@stayful.co.uk>", domain verified in Resend).
#   CRON_SECRET                   Vercel sends it as a bearer token on every cron in
#                                 vercel.json (all 33 schedules, 23 routes); without it
#                                 every cron is refused and nothing scheduled runs.
#                                 Generate any long random value; manual runs use
#                                 x-internal-secret instead.
INTERNAL_API_SECRET=
CRON_SECRET=
#   N8N_SHARED_SECRET             A second value accepted on x-internal-secret, at the same
#                                 trust level, and the one the site sends on
#                                 LEAD_ACTIVATION_WEBHOOK_URL. Put the same value in n8n's
#                                 "Stayful Internal API Secret" credentials. Exists so
#                                 INTERNAL_API_SECRET (sensitive, write-only in Vercel) never
#                                 has to be read back or rotated for n8n.
N8N_SHARED_SECRET=

# ── White-label lead funnels ─────────────────────────────────────────────
# CRM_ENCRYPTION_KEY encrypts a customer's third-party credentials at rest
# (their Monday API key, their webhook signing secret) with AES-256-GCM.
# 32 bytes, base64 or hex. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, saving a CRM connection fails loudly rather than storing the
# credential in the clear. There is no key id in the stored format, so both
# an old and a new key cannot be live at once: to rotate, decrypt with the
# old key and re-encrypt with the new one in a single migration.
CRM_ENCRYPTION_KEY=

# Key for the one-way digest of an estate/letting agent's name, used only to
# tell whether a relisted property came back with a different agent. Any
# non-empty string; generate one the same way as above. The agent's name is
# never stored either way — without this key the signal is simply dropped,
# because an unsalted digest of a few thousand UK agent brands would be
# reversible in seconds.
#
# Set the SAME value on production, preview and development: they share one
# database, so two keys would make a property crossing between them look as
# though its agent had changed.
#
# Each digest carries a short fingerprint of the key that made it, and the
# comparison only runs when both digests share one. So rotating the key is
# safe but lossy: nothing fires spuriously, and "came back with a new agent"
# goes unnoticed until each property has been seen once under the new key.
AGENT_HASH_KEY=

# Cloudflare Turnstile guards the PUBLIC funnel form at /f/<token>, which is
# the one page where a stranger's submission spends a customer's money.
# Both halves are needed — either alone leaves the check switched off.
#   Get them from Cloudflare dashboard → Turnstile → Add site.
# Unset, the widget does not render and the server check is a no-op, so a
# funnel that was live beforehand keeps working unchanged.
# The check runs BEFORE the daily caps are counted, so bot traffic cannot
# exhaust a customer's lead allowance on its way to being rejected.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Monday CRM ───────────────────────────────────────────────────────────
# REQUIRED for trial signups to appear in Monday. Without this, the
# trial→Monday hook logs "[Monday] skipped — MONDAY_API_KEY not set" and
# silently does nothing. (MONDAY_API_TOKEN is accepted as a fallback name.)
# Used by src/lib/apis/monday.ts (the sign-up row and the report PDF) and the
# Batch 20 funnel sync below.
MONDAY_API_KEY=

# Batch 20: the sales-funnel sync (src/lib/crm/monday-funnel) writes every
# member's row and group on the enquiries board (18413002067). Off until set
# to true; its dry runs (/api/internal/monday-funnel?dry=1, the backfill's GET)
# work either way. Every board, group and column id is in
# src/lib/crm/monday-funnel/config.ts: the old MONDAY_ENQUIRY_BOARD_ID,
# MONDAY_ENQUIRY_GROUP_ID and MONDAY_COL_* overrides are no longer read.
MONDAY_FUNNEL_ENABLED=
# Batch 21: the id of a numbers column "Weeks since sign-up" on the board,
# written with the same Monday–Sunday weeks as Active weeks, so the board's
# Engagement % formula can divide by it. Unset, the column is not written.
MONDAY_FUNNEL_WEEKS_COLUMN=

# ─── Listing links, deal workspace and the data broker ────────────────
#   PMI_API_KEY                   Property Market Intel (Bearer pmi_live_…): STR second
#                                 opinion on full reports (50 credits), area STR snapshot
#                                 (3 credits) and licensed listings sourcing (1 credit).
#                                 Missing key simply removes those rungs.
#   PMI_SECOND_OPINION=false      Turn off the PMI projection on full reports (default on,
#                                 within the daily budget).
#   PMI_API_BASE                  Another PMI host (default https://api.propertymarketintel.com/v1).
#                                 Nothing to set unless PMI says so.
#   PRICELABS_API_KEY             PriceLabs market data (X-API-Key): a second short-let
#                                 source for full reports when set; the admin billing
#                                 page shows whether it is on.
#   PRICELABS_AS_PRIMARY=true     Lets PriceLabs lead the short-let estimate instead of
#                                 Airbtics (off unless set).
#   AIRROI_API_KEY                Reserved; unused until added.
#   LISTING_SERVER_FETCH=false    Kill switch for fetching pasted listing pages from our
#                                 servers (default on). LISTING_SOURCES=rightmove,onthemarket,airbnb
#                                 narrows which sites may be fetched.
#   LISTING_RESOLVES_PER_DAY      Listings a member may check per day (default 30).
#   BROKER_BUDGET_<PROVIDER>      Daily global cap in pence per provider (AIRBTICS, PMI,
#                                 PROPERTYDATA, ONTHEMARKET, AIRROI). Defaults in
#                                 src/lib/broker/config.ts. BROKER_MEMBER_BUDGET_<PROVIDER>
#                                 caps one member's daily spend. Both are LIVE caps: a
#                                 provider at its cap answers nothing for the rest of the
#                                 UK day. Set per provider, e.g.
#                                   BROKER_BUDGET_AIRBTICS=20000
#                                   BROKER_MEMBER_BUDGET_AIRBTICS=2000
#                                 (pence per day; unset means the default).
#   SUPABASE_SERVICE_ROLE_KEY     Already required by /admin; the broker cache, spend
#                                 ledger and listing snapshots also use it.
#
# Daily listing re-checks and deal sourcing (vercel.json crons; same auth as
# /api/internal/alerts: Vercel's CRON_SECRET bearer or x-internal-secret).
#   LISTING_RECHECK_ENABLED=false Kill switch for the 06:00 UTC re-check of saved
#                                 listings (default on). Rightmove/OnTheMarket rows
#                                 are re-read daily for price and status changes;
#                                 Airbnb rows refresh tracked figures monthly. It
#                                 records changes only and sends nothing (Batch 6):
#                                 the alerts collector and the daily email carry them.
#   LISTING_RECHECK_MAX_PER_RUN   Listings re-read per run (default 40, 1 request/s; a bigger
#                                 pipeline drains over several days, stalest first).
#   SOURCING_ENABLED=false        Kill switch for daily picks (ON by default): the 07:00 UTC cron
#                                 (with resumable passes at 07:20 and 07:40, after a
#                                 04:45 market-snapshot warm-up) emails every
#                                 enrolled member AT MOST ONE listing a day that fits
#                                 their filter, or a Stayful house pick from the
#                                 best-scoring areas when they have no filter. Every
#                                 pick passes the short-let suitability check
#                                 (src/lib/listing/suitability.ts): no rooms or house
#                                 shares, no shared ownership, no retirement or park
#                                 homes, no leasehold unless the listing text permits
#                                 short lets; the listing page is read before the
#                                 send to confirm it. A member who says "not for
#                                 me" is asked why; each reason changes their next
#                                 picks (area, price, size, type, returns) and every
#                                 answer is stored for /admin/picks/responses. Picks
#                                 are on by default for everyone who has signed in;
#                                 paused subscriptions and members with less than one
#                                 pick's worth of credit are skipped. Each pick sent is
#                                 charged to the member at the pmi:daily_pick unit
#                                 (2p raw × markup = 10p at the seed table); the
#                                 searches themselves are house spend.
#   SOURCING_MAX_QUERIES_PER_RUN  Distinct (kind, area, budget, bedrooms) searches per
#                                 run across all members (default 150). PMI listings
#                                 first (1 credit each), OnTheMarket page as fallback.
#                                 PMI's free tier allows 2 requests per 10 s (one paced
#                                 retry per search); the Starter tier lifts that, so the
#                                 07:00 pass alone can answer every search.
#                                 Every email carries one-click unsubscribe headers
#                                 (/api/picks/unsubscribe/<token>) and the buttons land
#                                 on /p/<token>; members see every pick on /picks.
#                                 ?dry=1 (with the secret) reports who would get what
#                                 even while SOURCING_ENABLED is off.
#                                 A pick for an area the marketplace sweep covers is
#                                 drawn from the pool and charged the deal's ladder
#                                 price instead (see below); the email links to the
#                                 deal sheet on /deals.
#
# Member emails and the cap (Batch 6; src/lib/notify)
#   At most ONE non-billing email per member a day, and a second on Mondays (Your
#   week). Every capped email claims its slot in notification_sends first; billing
#   and receipt emails never do. Same auth as the other crons; every one takes ?dry=1.
#   DEAL_ALERTS_ENABLED=false     Kill switch for the 06:55 UTC collector
#                                 (/api/internal/deal-alerts): records price drops,
#                                 deals back on the market, deals getting attention
#                                 and deals gone on what each member tracks. Sends nothing.
#   DAILY_DIGEST_ENABLED=false    Kill switch for the 08:10 UTC digest
#                                 (/api/internal/daily-digest): the daily email for
#                                 anyone who had none from the picks run or the
#                                 picks-paused letter. Never charged.
#
# Deals marketplace (/deals; src/lib/marketplace)
#   MARKETPLACE_SWEEP_ENABLED=false   Kill switch for the sweep cron (ON by default): twelve
#                                 resumable passes every 10 minutes 05:00–06:50 UTC ask
#                                 the broker for every top scored area, both kinds
#                                 (PMI listings, 1 credit each; ~£2.40/day raw at 60
#                                 areas), screen what comes back and insert qualified
#                                 newcomers as pending_verify. The market snapshot is
#                                 warmed at 04:45 for it.
#   MARKETPLACE_SWEEP_AREAS       How many top scored areas the sweep covers (default 60).
#   MARKETPLACE_SWEEP_MAX_QUERIES Queries per pass (default 120 = 60 areas × 2 kinds).
#   DEMAND_SOURCING_ENABLED=true  Turns ON the demand-led searches (OFF by default, Batch 15):
#                                 twelve passes every 10 minutes 05:05–06:55 UTC search the
#                                 areas members' running profiles want that the sweep does
#                                 not cover, within billing_settings.demand_monthly_cap_pence
#                                 (/admin/demand). ?dry=1 and "Run a pass now" work either way.
#   MEMBER_SEARCH_ENABLED=true    Turns ON members' own searches (OFF by default, Batch 22): the free
#                                 signup search (layer 2, within billing_settings.signup_search_cap_pence
#                                 a member and signup_search_monthly_cap_pence a month) and the paid
#                                 deep search. Off: the reveal still ranks existing stock and shows
#                                 its what-ifs; no member search is queued or run.
#                                 /api/internal/member-searches?dry=1 works either way.
#   LOW_ENTRY_SEARCH_ENABLED=true Turns ON the nationwide low-entry search (OFF by default, Batch 16):
#                                 three passes at 03:00, 03:10 and 03:20 UTC ask every UK postcode
#                                 area for sale listings up to billing_settings.low_entry's price
#                                 cap (£135,000), about eight areas a pass so each area comes round
#                                 weekly, within the week's cap (£4). ?dry=1 and the /admin/deals
#                                 buttons work either way.
#   DEAL_CHECKS_ENABLED=true      Turns ON the daily paid checks (OFF by default, Batch 16, Part B):
#                                 a qualifying listing waits on the shortlist (pending_check) for
#                                 its own Airbnb comparables check instead of going live on the
#                                 area's average; five passes at 03:40–04:20 UTC take the day's
#                                 checks by stream within billing_settings.deal_checks (20 a day,
#                                 £1 raw). With it off nothing is shortlisted and the old path is
#                                 untouched. /api/internal/deal-checks?dry=1 and the /admin/deals
#                                 buttons work either way.
#   MARKETPLACE_RECHECK_ENABLED=false Kill switch for the hourly recheck (ON by default, at :30): retires
#                                 deals listed 90+ days or unconfirmed 21+ days without a
#                                 fetch, then reads listing pages in priority order
#                                 (entry checks, opens waiting on a check, what members
#                                 were shown, rentals, the top bands, the tail).
#   MARKETPLACE_RECHECK_CAP_RIGHTMOVE  Rightmove pages per hourly run (default 30).
#   MARKETPLACE_RECHECK_CAP_OTM   OnTheMarket pages per hourly run (default 60).
#   DEALS_PHOTO_SECRET            Signs the expiring photo URLs the grid loads (falls back to
#                                 INTERNAL_API_SECRET; 16+ chars). Without either the photo
#                                 route 404s and cards show a placeholder.
#                                 The open price ladder lives in billing_settings
#                                 (deal_open_ladder; edited on /admin/deals), banded on
#                                 the deal's annual profit: 25p / 40p / 60p / 80p / £1.
#
# Lead-form provisioning (/api/internal/leads/provision)
#   LEAD_ACTIVATION_WEBHOOK_URL   Where /auth/callback posts { event: "lead_activated", ... }
#                                 the first time a member provisioned from a lead form
#                                 signs in (n8n forwards it to Meta's Conversions API).
#                                 Optional; the stamp on profiles.lead_activated_at is
#                                 written either way.
#
# Browser extension (Part 2)
#   NEXT_PUBLIC_EXTENSION_ID      The Chrome extension id (from chrome://extensions or the
#                                 Web Store). /extension/connect hands the token straight
#                                 to the extension when set; without it the member pastes
#                                 the token into the extension popup.
#   EXTENSION_IDS                 Comma-separated extension ids allowed to call /api/ext/*
#                                 cross-origin (CORS). Defaults to NEXT_PUBLIC_EXTENSION_ID.

# ── Text alerts (Twilio SMS; Batch 8, src/lib/sms) ─────────────────────────
# One text a day at most, 08:00–20:00 UK time, to members who verified a UK
# mobile and switched texts on (off for everyone by default), capped per month
# by billing_settings.sms_monthly_cap (8). Texts are free to members: the cost
# is house spend, logged in provider_calls (twilio:sms) and sms_messages.
# Without the three Twilio values nothing is ever sent (logged, never an error)
# and both webhooks refuse every request, because nothing can be verified.
#   TWILIO_ACCOUNT_SID            The Twilio account (Console → Account info).
#   TWILIO_AUTH_TOKEN             Its auth token. Also the key Twilio signs every
#                                 webhook with: /api/twilio/inbound (STOP/START) and
#                                 /api/twilio/status (delivery) refuse anything unsigned.
#   TWILIO_MESSAGING_SERVICE_SID  The Messaging Service holding our UK mobile number
#                                 (MG…). Its incoming-message webhook must point at
#                                 https://<site>/api/twilio/inbound, and Advanced
#                                 Opt-Out should be on (it confirms STOP/START).
#   TWILIO_FROM_NUMBER            The sender (+447…) when no Messaging Service is set. The
#                                 number's own "A message comes in" webhook must then
#                                 point at https://<site>/api/twilio/inbound.
#   DEALS_PHOTO_SECRET or INTERNAL_API_SECRET (16+ characters, set above) keys the
#                                 verification codes' hashes: without one, members
#                                 cannot verify a number.
#   SMS_DRY_RUN=true              Log every text (verification codes included) instead
#                                 of sending it. Set on Preview.
#   SMS_ALERTS_ENABLED=true       Lets the alert cron (/api/internal/sms-alerts, every
#                                 15 min) send. OFF unless set; members can still verify.
#                                 Manual runs take ?dry=1 and ?only=<email>.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ── Calls from Stayful Intelligence (ElevenLabs + Twilio; Batch 23, src/lib/voice) ──
# One number for calls and texts: the Batch 8 UK mobile above, voice-enabled
# and imported into ElevenLabs (README, step 19). TWILIO_FROM_NUMBER must be
# set to it (+447…): it is the number on Stayful Intelligence's contact card.
# The voice is ELEVENLABS_VOICE_ID (one voice for the analyser and calls, see
# above); ELEVENLABS_API_KEY needs agent read/write permission.
#   ELEVENLABS_AGENT_ID          The agent (Agents → the Stayful Intelligence agent).
#   ELEVENLABS_PHONE_NUMBER_ID   The imported Twilio number's id in ElevenLabs.
#   ELEVENLABS_WEBHOOK_SECRET    The HMAC secret of the post-call webhook you create in
#                                ElevenLabs → Settings → Webhooks for
#                                <site>/api/voice/elevenlabs/webhook (<site> is
#                                NEXT_PUBLIC_SITE_URL): anything unsigned is refused.
#                                The Sync attaches it to this agent only; never set it
#                                workspace-wide (other agents use those settings).
#   ELEVENLABS_INITIATE_SECRET   Any long random string. The Sync sets it as the
#                                x-si-secret header of the agent's own
#                                conversation-initiation webhook
#                                (<site>/api/voice/elevenlabs/initiate).
#   ELEVENLABS_TOOL_SECRET       Any long random string: sent to ElevenLabs with each
#                                call as the secret__tool_token variable and checked on
#                                every tool request (/api/voice/tools/*).
#   SI_CALLS_ENABLED=true        Lets calls be placed and texts be answered. OFF unless
#                                set: set it LAST, after the agent is synced.
#   SI_CALLS_DRY_RUN=true        Log every call and text instead of placing or sending
#                                it. Set on Preview.
# The cron (/api/internal/si-calls, every 5 min) takes ?dry=1 and ?only=<email>.
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_INITIATE_SECRET=
ELEVENLABS_TOOL_SECRET=
SI_CALLS_ENABLED=
SI_CALLS_DRY_RUN=

# ── Stayful Intelligence knowledge base: the nightly gap job (Batch 24) ──
# /api/internal/si-knowledge (02:50 UTC) groups the questions Stayful
# Intelligence couldn't answer and drafts answers for Zac to approve on
# /admin/intelligence/gaps, with Haiku 4.5 and Sonnet 5.5 (ANTHROPIC_API_KEY).
# House spend, never a member's credit, inside billing_settings
# si_gap_monthly_cap_pence (£15); once a UK day. On Mondays the same run sends
# the weekly gaps email to the admin address (/admin/feedback).
#   SI_GAP_JOB_ENABLED=true      Lets the nightly run make model calls and write.
#                                OFF unless set. ?dry=1 works either way (it
#                                makes the calls, counted against the cap, and
#                                writes nothing else); &estimate=1 makes none.
SI_GAP_JOB_ENABLED=

# ── Meta pixel + Conversions API (ads measurement; Batch 19) ─────────────
# Consent first: nothing Meta loads or is sent until a visitor taps Accept on
# the cookie banner (src/components/tracking). The pixel runs only on
# production, only on the pages listed in src/lib/tracking/config.ts, and
# only when the address has nothing after the page (the address bar is tidied
# first). Server events go only for members whose saved choice is Accept.
# Every setting here may be missing: each case below quietly does nothing
# and is never an error. "Production" means VERCEL_ENV=production (Vercel
# sets it): a production build run anywhere else (a local `next start`, CI)
# never loads the pixel or sends live events.
#
# NEXT_PUBLIC_META_PIXEL_ID  The dataset (pixel) id, digits only. Read by
#                        src/lib/meta/env.ts from the root layout (browser) and
#                        the server (the Conversions API dataset). Baked in at
#                        build time: redeploy after changing it. Without it:
#                        no cookie banner, no pixel, no server events;
#                        sign-up attribution is still recorded (without the
#                        30-day cookie). Production only.
# META_CAPI_ACCESS_TOKEN The Conversions API access token. Server only: never
#                        sent to the browser, never logged, never stored.
#                        Without it no server events go, and all five
#                        conversions (CompleteRegistration, ProfileComplete,
#                        FirstReport, Subscribe, Purchase) still reach Meta from
#                        the browser. Production only.
# META_TEST_EVENT_CODE   Only while testing (e.g. TEST12345). Every server event
#                        then carries it, so it shows in Events Manager → Test
#                        events and NOT in live reporting. Remove it and
#                        redeploy when testing is done (/admin/signups shows
#                        whether it is on). With it set, a preview or local
#                        server may send test events too.
# META_DRY_RUN=true      Log what would be sent to the Conversions API instead
#                        of sending it (like SMS_DRY_RUN).
#
# One-off setup in Meta Events Manager (dataset → Settings): Automatic
# advanced matching OFF (code cannot turn it off), "Track events automatically
# without code" OFF, first-party cookies ON, and Traffic permissions limited to
# the site's domain. README deploy step 15 has the rest.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
